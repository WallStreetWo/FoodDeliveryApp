@model List<FoodDeliveryApp.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-2">Notifications</h1>
            <p class="text-muted mb-0">Order updates, delivery updates, and SnackDash activity will appear here.</p>
        </div>

        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    Mark all as read
                </button>
            </form>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info rounded-4">
            You do not have any notifications yet.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var notification in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 @(notification.IsRead ? "" : "border-start border-4 border-primary")">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                                        <h5 class="mb-0">@notification.Title</h5>

                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary">New</span>
                                        }
                                    </div>

                                    <p class="text-muted mb-2">@notification.Message</p>

                                    <div class="small text-muted">
                                        @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                    </div>

                                    @if (notification.OrderId.HasValue)
                                    {
                                        <div class="mt-3">
                                            <a asp-controller="OrderTracking"
                                               asp-action="Track"
                                               asp-route-id="@notification.OrderId"
                                               class="btn btn-sm btn-outline-primary">
                                                View Order
                                            </a>
                                        </div>
                                    }
                                </div>

                                @if (!notification.IsRead)
                                {
                                    <form asp-action="MarkAsRead" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@notification.NotificationId" />

                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            Mark as read
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>