@model List<FoodDeliveryApp.Models.ApplicationUser>

@{
    ViewData["Title"] = "Manage Drivers";
    var assignedOrderCounts = ViewBag.AssignedOrderCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="mb-2">Manage Drivers</h1>
            <p class="text-muted mb-0">Create and view SnackDash delivery drivers.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Add Driver
        </a>
    </div>

    @if (TempData["AdminDriverSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["AdminDriverSuccess"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info rounded-4">
            No drivers have been created yet.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Driver</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Assigned Orders</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var driver in Model)
                            {
                                var count = assignedOrderCounts.ContainsKey(driver.Id)
                                    ? assignedOrderCounts[driver.Id]
                                    : 0;

                                <tr>
                                    <td class="fw-semibold">
                                        @(driver.FullName ?? "Unnamed Driver")
                                    </td>

                                    <td>
                                        @(driver.Email ?? "-")
                                    </td>

                                    <td>
                                        @(driver.Address ?? "No address")
                                    </td>

                                    <td>
                                        @count
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>